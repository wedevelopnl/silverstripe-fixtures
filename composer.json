{
    "name": "wedevelopnl/silverstripe-fixtures",
    "description": "Fast declarative test data loader for SilverStripe",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "homepage": "https://wedevelop.nl",
    "keywords": [
        "silverstripe",
        "fixtures",
        "testing"
    ],
    "authors": [
        {
            "name": "WeDevelop",
            "email": "development@wedevelop.nl"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "tomasvotruba/class-leak": "^2.3",
        "tomasvotruba/type-coverage": "^2.0",
        "wernerkrauss/silverstripe-rector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\Fixtures\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\Fixtures\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
