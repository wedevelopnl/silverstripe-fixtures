# Enforce LF line endings
* text=auto eol=lf

# Clean package: keep dev, build and test files out of the dist archive
# Packagist publishes (`git archive`), while leaving them in the repository.

# Dotfiles and dotdirs
/.apm                    export-ignore
/.claude                 export-ignore
/.docker                 export-ignore
/.editorconfig           export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore

# Dev and test directories
/docs                    export-ignore
/tests                   export-ignore

# Dev and build config files
/AGENTS.md               export-ignore
/apm.yml                 export-ignore
/CLAUDE.md               export-ignore
/CONTRIBUTING.md         export-ignore
/GEMINI.md               export-ignore
/Taskfile.yml            export-ignore
