{
    "_comment": "Base variant: the framework alone (recipe-core), no Versioned or Fluent. Keep in sync with composer.modules.json, which differs only in require.",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "silverstripe/recipe-core": "^6.0",
        "wedevelopnl/silverstripe-fixtures": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/module",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "_comment_require_dev": "QA toolchain is pinned to exact versions so a relock cannot silently float into a rule or behavior change that breaks the build. Runtime deps stay on ranges so the module keeps testing against the latest SS6.x. Pins must resolve on php 8.3, the module's floor.",
    "require-dev": {
        "cambis/silverstan": "2.2.0",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.3.5",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpunit/phpunit": "12.5.43",
        "rregeer/phpunit-coverage-check": "0.3.1",
        "tomasvotruba/class-leak": "2.3.6",
        "tomasvotruba/type-coverage": "2.5.1",
        "wernerkrauss/silverstripe-rector": "1.4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\Fixtures\\Tests\\": "vendor/wedevelopnl/silverstripe-fixtures/tests/"
        }
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        },
        "_comment_platform": "Resolve against the module's PHP floor: every matrix leg (8.3/8.4/8.5) installs from this one lock, and it makes `task relock` reproducible regardless of the host PHP.",
        "platform": {
            "php": "8.3.0"
        }
    }
}
